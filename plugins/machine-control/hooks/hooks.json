{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.c)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/warn-kflop-c-edit.sh"
          },
          {
            "type": "command",
            "if": "Write(*.c)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/warn-kflop-c-edit.sh"
          }
        ]
      }
    ]
  }
}
